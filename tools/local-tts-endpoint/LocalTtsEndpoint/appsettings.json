{
  "LocalTts": {
    "Port": 8000,
    "BindHost": "0.0.0.0",
    "OutputDirectory": "tts-output",
    "DefaultEngine": "kokoro",
    "DefaultVoice": "narrator",
    "DefaultFormat": "wav",
    "Seed": 1701,
    "LexiconPath": "lexicon.v1.json",
    "RenderPlatform": "platform-a-local-cpu",
    "AllowRemoteGpuEngines": false,
    "IncrementalRendering": false,
    "ChunkSizeCharacters": 900,
    "SaveFiles": true,
    "EngineRedirects": {
      "xtts-v2": "kokoro",
      "gpt-sovits": "kokoro"
    },
    "Engines": {
      "kokoro": { "Type": "OpenAiCompatible", "BaseUrl": "http://127.0.0.1:8880", "Model": "kokoro", "SampleRate": 24000 },
      "silent": { "Type": "Silent", "BaseUrl": "", "SampleRate": 24000 },
      "xtts-v2": { "Type": "OpenAiCompatible", "BaseUrl": "http://127.0.0.1:8020", "Model": "xtts-v2", "SampleRate": 24000 },
      "gpt-sovits": { "Type": "OpenAiCompatible", "BaseUrl": "http://127.0.0.1:9880", "Model": "gpt-sovits", "SampleRate": 32000 },
      "intel-ipex-cpu": { "Type": "OpenAiCompatible", "BaseUrl": "http://127.0.0.1:8890", "Model": "kokoro", "SampleRate": 24000 }
    },
    "Voices": {
      "default": { "Engine": "kokoro", "Speaker": "af_heart" },
      "narrator": { "Engine": "kokoro", "Speaker": "af_heart" },
      "cast.alice": { "Engine": "kokoro", "Speaker": "af_bella" },
      "cast.bob": { "Engine": "kokoro", "Speaker": "am_adam" },
      "ci.silent": { "Engine": "silent", "Speaker": "default" }
    }
  }
}
